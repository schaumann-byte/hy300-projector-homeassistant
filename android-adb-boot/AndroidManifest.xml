<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by aurora@aurora-smart-home (ha-integration-dev skill)
     https://github.com/tonylofgren/aurora-smart-home
     ADB Boot: re-enables Wireless debugging (adb_wifi_enabled) after every boot,
     because Android 11+ turns it off on reboot. No UI, no INTERNET permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="br.casa.adbboot">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- granted once over adb: pm grant br.casa.adbboot android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- lets the boot receiver bring the default launcher (Projectivity) to front:
         appops set br.casa.adbboot SYSTEM_ALERT_WINDOW allow -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application android:label="ADB Boot" android:allowBackup="false">
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".EnableAdbJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
